	"permissions": [
		"sessions.read",
		"sessions.read.workspace",
		"workbench.navigate"
	],
	"contributes": {
		"panels": [
			{
				"id": "main",
				"title": "会话记录管理",
				"entry": "app.html",
				"icon": "table",
				"presentation": "page"
			}
		],
		"commands": []
	}
}
